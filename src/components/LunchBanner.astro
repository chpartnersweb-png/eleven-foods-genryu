---
import { brand } from '../data/site';
---
<aside class="lunch-banner" aria-label="平日のランチサービス" data-reveal>
  <span class="lunch-tag">平日<br />限定</span>
  <div class="lunch-title"><span>ランチサービス</span><strong>麺増量<span>無料</span></strong></div>
  <div class="lunch-hours"><strong>{brand.lunch.hours}</strong><p>{brand.lunch.note}</p></div>
  <span class="lunch-deco" aria-hidden="true">満腹、満足。</span>
</aside>
