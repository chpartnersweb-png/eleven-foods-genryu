---
interface Props { name: 'arrow' | 'instagram' | 'pin' | 'phone' | 'plus'; class?: string }
const { name, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><path d="M4 12h15M13 5l7 7-7 7" /></>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none" /></>}
  {name === 'pin' && <><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'phone' && <path d="m6 3 4 5-3 3a17 17 0 0 0 6 6l3-3 5 4-2 3C10 23 1 14 3 6Z" />}
  {name === 'plus' && <path d="M12 4v16M4 12h16" />}
</svg>
